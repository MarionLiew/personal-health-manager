dist/

# Real health data and runtime state must never enter Git.
data/database/*
data/reports/*
data/imports/*
data/dicom/*
data/apple_health/*
data/exports/*
data/backups/*
data/quarantine/*
!data/**/.gitkeep
data/
*.sqlite3
*.sqlite3-*
*.db
*.dcm
*.dicom
export.xml

# Local secrets and generated artifacts.
*.key
*.pem
coverage.xml
.coverage
htmlcov/
*.log
logs/
tmp/
*.tmp
