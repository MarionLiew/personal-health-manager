# Real health data and runtime state must never enter Git.
# NOTE: config/hermes.yaml is already tracked; ignore does not untrack history.
/config/hermes.yaml
.env.*
!.env.example
*.pdf
*.PDF
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.dcm
*.dicom
*.p12
*.pfx
*.key
*.pem
*.zip
*.7z
*.tar.gz
*.heic
*.nii
*.nii.gz
*.nrrd
*.xml
!uv.lock
data/database/*
data/reports/*
data/imports/*
data/dicom/*
data/apple_health/*
data/exports/*
data/backups/*
data/quarantine/*
!data/**/.gitkeep
data/
export.xml

